# ── HIVE environment ─────────────────────────────────────────────────────────
# Copy to .env. EVERY variable has a working default — none are required.
# The system runs with no keys, no camera, and no phones.

# ── Models: NVIDIA NIM (OpenAI-compatible). One key for everything. ──────────
# Get a free key at build.nvidia.com. Without it: template planner + CV-only
# perception. The full demo still completes.
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Perception — continuous structured scene reads off the camera feed
VLM_FAST_MODEL=nvidia/nemotron-nano-12b-v2-vl
# Perception — physical-world reasoning: deviation adjudication, hard calls
VLM_REASON_MODEL=nvidia/cosmos3-nano-reasoner
# Planning — goal → validated task graph (agentic reasoning + tool calling)
PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b

VLM_ENABLED=true
VLM_FAST_HZ=1.4          # raise cautiously: cost and latency scale linearly

# ── Runtime ──────────────────────────────────────────────────────────────────
DEMO_MODE=true           # shorter timeouts, simulated workers, polished copy
WORLD_MODE=live           # live | assisted | simulation
CAMERA_INDEX=0
TICK_HZ=4.0
VERIFICATION_THRESHOLD=0.70
PORT=8000

# ── Voygr Callwright voice escalation ────────────────────────────────────────
# Team key, 2000 credits (~200 calls), expires 2026-08-22. Already provisioned.
CALLWRIGHT_API_KEY=pk_live_7f130e9d22a7480b8816ec0033cf4de7
CALLWRIGHT_BASE_URL=https://api.voygr.tech
# Escalation ships DISARMED. Set a number AND arm it in Advanced Controls
# before the demo, or no call is ever placed.
ESCALATION_PHONE=
